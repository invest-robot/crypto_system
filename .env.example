# MongoDB Configuration
# Copy this file to .env and fill in your own values

# vnpy database: K-line/candle market data
MONGO_VNPY_USER=your_username
MONGO_VNPY_PASS=your_password
MONGO_VNPY_HOST=your_mongodb_host
MONGO_VNPY_PORT=27024
MONGO_VNPY_DB=vnpy

# crypto databases: strategy signals and strategy info
# Two databases are used:
#   - crypto_daily: trading signals (btc_strategy, eth_strategy, sol_strategy)
#   - crypto_strategy: strategy descriptions (strategy_info)
# The database names are fixed in server code, only credentials/host/port are configurable here
MONGO_CRYPTO_USER=your_username
MONGO_CRYPTO_PASS=your_password
MONGO_CRYPTO_HOST=your_mongodb_host
MONGO_CRYPTO_PORT=27024